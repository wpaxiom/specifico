{
  "name": "specifico",
  "version": "1.0.5",
  "description": "=== Cartick - Advanced Cart for WooCommerce ===\r Contributors: wpaxiom\r Requires at least: 5.8\r Tested up to: 5.8.2\r Requires PHP: 7.3\r Stable tag: 1.0.0\r License: GPLv2 or later\r License URI: https://www.gnu.org/licenses/gpl-2.0.html",
  "scripts": {
    "clean": "rm -rf build/*",
    "build": "wp-scripts build && npm run tailwind:build && npm run wp:i18n",
    "tailwind:build": "npx tailwindcss -i ./assets/src/css/admin.css -o ./assets/dist/css/admin.css --minify",
    "composer:build": "composer install --no-dev && composer dump-autoload -o",
    "wp:i18n": "wp i18n make-pot . && wp i18n make-json languages --no-purge",
    "make-zip": "node scripts/make-zip.js",
    "sync": "node scripts/sync-to-public.js",
    "sync:apply": "node scripts/sync-to-public.js --apply",
    "start": "wp-scripts start",
    "tailwind": "npx tailwindcss -i ./assets/src/css/admin.css -o ./assets/dist/css/admin.css --watch"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shuvo586/specifico.git"
  },
  "author": "WpAxiom",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/shuvo586/specifico/issues"
  },
  "homepage": "https://github.com/shuvo586/specifico#readme",
  "devDependencies": {
    "@tanstack/react-table": "^8.12.0",
    "@wordpress/browserslist-config": "^2.7.0",
    "@wordpress/i18n": "^4.23.0",
    "@wordpress/scripts": "^32.2.0",
    "archiver": "^7.0.1",
    "autoprefixer": "^10.4.17",
    "axios": "^1.2.0",
    "postcss": "^8.4.33",
    "postcss-loader": "^8.1.0",
    "postcss-preset-env": "^9.3.0",
    "react-colorful": "^5.6.1",
    "rtlcss-webpack-plugin": "^4.0.7",
    "style-loader": "^3.3.4",
    "stylelint-config-wordpress": "^17.0.0",
    "tailwindcss": "^3.4.1"
  },
  "dependencies": {
    "react-select": "^5.8.0"
  }
}
