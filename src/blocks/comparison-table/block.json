		"ids": {
			"type": "array",
			"items": { "type": "number" },
			"default": []
		}
	},
	"supports": {
		"html": false,
		"align": [ "wide", "full" ]
	},
	"editorScript": "file:../../blocks.js",
	"editorStyle": "file:../../blocks.css",
	"style": "file:../../blocks.css",
	"render": "file:./render.php"
}
