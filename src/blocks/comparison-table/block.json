{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "specifico/comparison-table",
	"title": "Comparison Table",
	"category": "specifico",
	"icon": "columns",
	"description": "Display a side-by-side WooCommerce product specification comparison.",
